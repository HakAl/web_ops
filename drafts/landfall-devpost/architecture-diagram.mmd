%% Landfall architecture diagram source
%% Status: editable draft for architect review. Do not publish.
flowchart TB
  classDef cloud fill:#D9F1F2,stroke:#087E8B,stroke-width:3px,color:#152536
  classDef local fill:#FCFBF7,stroke:#B56A00,stroke-width:3px,stroke-dasharray:8 6,color:#152536
  classDef authority fill:#FFFFFF,stroke:#152536,stroke-width:5px,color:#152536
  classDef human fill:#FFF4DB,stroke:#152536,stroke-width:2px,color:#152536
  classDef note fill:#FCFBF7,stroke:#526476,stroke-width:1px,color:#526476
  classDef refusal fill:#FFF4F2,stroke:#B42318,stroke-width:3px,color:#152536

  H["Support lead<br/>non-code-reviewing operator"]:::human
  FR["ONE HUMAN APPROVAL<br/>FleetRun initiation<br/>paths · budgets · attempts · predicates"]:::human
  H --> FR

  subgraph RC["REAL CLOUD PROBE"]
    direction LR
    CR["Cloud Run probe<br/>bounded vertical slice"]:::cloud
    GA["ADK + Gemini 3.7 Flash<br/>structured triage"]:::cloud
    FS[("Firestore<br/>AUTHORITATIVE STATE<br/>FleetRun · work · attempt<br/>receipt · decision · outbox")]:::authority
    OR["Outbox relay<br/>publishes outside transaction"]:::cloud
    PS["Pub/Sub<br/>at-least-once transport"]:::cloud
    CE["Consumer<br/>deduplicates on event_id"]:::cloud
    CR --> GA --> FS
    FS -->|transaction writes outbox| OR --> PS --> CE -->|one logical effect| FS
  end

  FR --> FS

  subgraph LG["DETERMINISTIC LOCAL GOVERNANCE DEMONSTRATION"]
    direction LR
    HAR["Kill harness<br/>observes local process exit"]:::local
    SUP["Supervisor<br/>admission · routing · succession"]:::local
    WN["Worker attempt N<br/>checkpoint + evidence reference<br/>cannot write terminal state"]:::local
    WS["Successor N+1<br/>parent_attempt_id = N"]:::local
    WO["Another work item<br/>continues"]:::local
    VER{{"Verifier<br/>deterministic, not a model<br/>retrieves or reproduces evidence"}}:::local
    STALE["stale_attempt<br/>terminal state unchanged"]:::refusal

    HAR -->|local process exit| WN
    SUP --> WN
    WN -->|lease expiry, then atomic generation bump| WS
    SUP --> WO
    WS -->|artifact reference only| VER
    WN -. authentic predecessor closeout .-> STALE
  end

  FS -->|authoritative cursor| SUP
  WN -->|checkpoint and reference| FS
  STALE -->|idempotent refusal decision| FS
  VER -->|verifier-controlled terminal write| FS
  WO -->|independent progress| FS

  CON["Console<br/>READ-ONLY, NON-AUTHORITATIVE<br/>role-level projection"]:::local
  FS -->|read path only| CON

  RULE1["Lease expiry proves expiry, not death"]:::note
  RULE2["Unknown authorizes no terminal write"]:::note
  RULE3["Runtime lock: Gemini and ADK on Cloud Run · Pub/Sub · Firestore"]:::note
  RULE4["Transactions write outbox records; publishing occurs outside transactions"]:::note
  RULE5["Google references: Firestore transactions https://cloud.google.com/firestore/docs/manage-data/transactions · Pub/Sub delivery https://cloud.google.com/pubsub/docs/subscriber"]:::note

  RULE1 --- RULE2 --- RULE3 --- RULE4 --- RULE5
